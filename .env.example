# Copy this file to .env for Docker, or load it into your process manager.
# Values shown below assume data/config files are mounted below /data.

# Dashboard server
VPD_BACKEND_HOST=0.0.0.0
VPD_BACKEND_PORT=8010
VPD_BACKEND_WORKERS=1
# Production serves the frontend and /api from the same origin.
# Leave this empty unless a separate browser origin must call the API.
# Multiple origins may be supplied comma-separated.
# Example:
# VPD_ALLOWED_ORIGINS=https://poi-debugger.company.com
VPD_ALLOWED_ORIGINS=

# Routing services as seen FROM the dashboard server/container. These are not
# browser URLs. Use private IPs, internal DNS, or Docker/Kubernetes service names.
VPD_VALHALLA_URL=http://valhalla.internal:8002
VPD_VALHALLA_TIMEOUT_SECONDS=30
VPD_OSRM_URL=http://osrm.internal:5000
VPD_OSRM_PROFILE=driving
VPD_OSRM_TIMEOUT_SECONDS=30

# Active dashboard dataset. If this ID is not in YAML, the backend creates it
# from these environment values at startup.
VPD_ACTIVE_DATASET=deployment
VPD_DATASET_NAME=Company-landmark-dataset
VPD_POI_CSV_PATH=/data/landmarks.csv
VPD_POI_GEOJSON_PATH=/data/landmarks.geojson
VPD_PBF_PATH=/data/map.osm.pbf
VPD_TILES_PATH=/data/valhalla_tiles
VPD_VALHALLA_CONFIG_PATH=/data/valhalla.json
VPD_SCENARIO_DIR=/data/scenarios

# Candidate Analysis debug sidecars.
#
# IMPORTANT FOR OSRM:
# This JSONL must come from the SAME osrm-extract execution that produced
# the .osrm dataset currently served by VPD_OSRM_URL. Candidate Analysis
# joins extraction evidence to runtime maneuvers using maneuver.turn_id.
VPD_OSRM_LANDMARK_DEBUG_JSONL=/data/osrm/turn_debug_v2.jsonl

# Optional Valhalla association diagnostics. If configured, keep this file
# aligned with the tile set served by VPD_VALHALLA_URL.
# VPD_VALHALLA_ASSOCIATION_DEBUG_JSONL=/data/valhalla/association_debug.jsonl

# Frontend appearance
VPD_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
VPD_DEFAULT_CENTER=77.2090,28.6139
VPD_DEFAULT_ZOOM=11
